# Mesmo domínio presente no certificado TLS e publicado no DNS.
TURN_REALM=turn.risk.example

# IP público. Se o host estiver atrás de NAT, use PUBLICO/PRIVADO, por exemplo:
# TURN_EXTERNAL_IP=203.0.113.10/10.0.0.10
TURN_EXTERNAL_IP=203.0.113.10

# Arquivo chmod 600 contendo o resultado de: openssl rand -hex 32
# O MESMO valor deve existir como TURN_SECRET no emissor de credenciais.
TURN_SECRET_FILE=/etc/risk/secrets/turn-secret

# Caminhos absolutos no host, normalmente gerenciados pelo Let's Encrypt.
TURN_CERT_FILE=/etc/letsencrypt/live/turn.risk.example/fullchain.pem
TURN_KEY_FILE=/etc/letsencrypt/live/turn.risk.example/privkey.pem

# Limites iniciais conservadores; ajuste após observar uso de banda/alocações.
TURN_USER_QUOTA=24
TURN_TOTAL_QUOTA=1200
TURN_MAX_BPS=0
TURN_BPS_CAPACITY=0
