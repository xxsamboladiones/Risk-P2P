DATABASE_URL=postgres://risk:risk_dev@localhost:5432/risk
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false
WEB_ORIGINS=risk://app,http://localhost:5173,http://localhost:5190
TURN_HOST=localhost
TURN_PORT=3478
TURN_SECRET=replace-with-a-random-turn-secret
# Produção: habilite os dois listeners TLS oferecidos pelo Coturn.
# TURN_TLS_PORT=5349
# TURN_TLS_ALT_PORT=443
TURN_CREDENTIAL_TTL_SECONDS=3600
TURN_CREDENTIAL_REQUESTS_PER_MINUTE=30
TURN_ALLOW_UNAUTHENTICATED_CREDENTIALS=false
# Habilite somente se a API aceitar tráfego exclusivamente de um proxy confiável.
TURN_TRUST_PROXY_HEADERS=false

# Opcional para builds web que usam uma API HTTP externa. O desktop ignora isso e
# recebe a URL/token do sidecar em runtime. Durante `vite serve`, localhost:5173 usa
# o proxy /__risk-api para falar com o mesmo sidecar iniciado por `pnpm dev:desktop`.
# VITE_API_URL=https://api.example.com
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key
VITE_DEBUG_SIGNALING=false
VITE_ENABLE_LEGACY_SERVER=false
# Endpoint HTTPS remoto que emite credenciais TURN temporárias. Não coloque
# TURN_SECRET, username ou credential no build.
# VITE_TURN_CREDENTIALS_URL=https://auth.risk.example/rtc/credentials

# Opcional: substitui o STUN de fallback por uma lista ICE definida pelo deploy.
# Credenciais TURN colocadas aqui ficam embutidas no frontend e NÃO devem ser tratadas como segredo permanente.
# VITE_ICE_SERVERS_JSON=[{"urls":["stun:stun.example.com:3478"]}]
