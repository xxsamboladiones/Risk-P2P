DATABASE_URL=postgres://risk:risk_dev@localhost:5432/risk
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false
WEB_ORIGINS=http://localhost:5173,http://localhost:5190
TURN_HOST=localhost
TURN_PORT=3478
TURN_SECRET=replace-with-a-random-turn-secret

# Opcional no build de produção. Se omitida, o cliente entra em modo P2P local.
VITE_API_URL=http://localhost:8080
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key
VITE_DEBUG_SIGNALING=false

# Opcional: substitui o STUN de fallback por uma lista ICE definida pelo deploy.
# Credenciais TURN colocadas aqui ficam embutidas no frontend e NÃO devem ser tratadas como segredo permanente.
# VITE_ICE_SERVERS_JSON=[{"urls":["stun:stun.example.com:3478"]}]
